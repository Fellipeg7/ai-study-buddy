# ===========================================================================
# AI Study Buddy — configuração de exemplo
# ---------------------------------------------------------------------------
# Copie este arquivo para config.env e preencha os valores:
#     cp config.example.env config.env
#
# O config.env real NUNCA deve ser versionado (está no .gitignore).
# ===========================================================================

# --- Telegram ---------------------------------------------------------------
# Token do bot criado com o @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExemploDeTokenSubstitua

# --- OpenAI -----------------------------------------------------------------
# Chave de API: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-exemplo-substitua
# Modelo usado para resumos e geração de flashcards
OPENAI_MODEL=gpt-4o-mini

# --- Aplicação --------------------------------------------------------------
# Caminho do banco SQLite local
DATABASE_PATH=study.db
# Quantidade máxima de revisões agendadas por dia
REVIEWS_PER_DAY=20
